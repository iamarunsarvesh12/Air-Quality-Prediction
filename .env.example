# AeroSense TN — Environment Configuration Template
# Copy this file to .env to customize environment settings

# Server Configuration
API_PORT=8000
FRONTEND_PORT=5500
API_HOST=127.0.0.1

# Telemetry Source Configuration
PRIMARY_DATA_SOURCE="Open-Meteo Air Quality & Weather API"
SECONDARY_DATA_SOURCE="CPCB Monitoring Network Telemetry"
DATA_CACHE_TTL_SECONDS=300

# Machine Learning Engine
MODEL_TYPE="RandomForest"
MODEL_PATH="backend/model.rds"
NAAQS_STANDARD="Indian National Air Quality Index (NAQS)"
